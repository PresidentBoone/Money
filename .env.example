# Stripe — get from stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Vercel KV — auto-set when you add the KV integration in Vercel dashboard.
# For local testing with `vercel dev`, copy these from the Vercel project settings.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Local UI dev only — set to a number to render the UI at that profit level
# without needing Stripe or KV. e.g. 1840 puts the avatar between milestones 1 and 2.
# Remove or leave empty for production.
VITE_MOCK_PROFIT=

# Optional passcode gate. If set, visitors must enter this code on first load.
# Leave empty to deploy without any gate.
VITE_ACCESS_CODE=
