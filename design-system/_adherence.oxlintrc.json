{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/money/**",
              "ui_kits/were-rich/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Anton|Space Grotesk|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Anton, Space Grotesk, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|size|glow|ring|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, alt, size, glow, ring, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='ring'] > Literal[value!=/^(?:green|gold|none)$/]",
        "message": "<Avatar> ring must be one of 'green' | 'gold' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|dot|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, dot, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:unlocked|locked|live|cash|neutral)$/]",
        "message": "<Badge> tone must be one of 'unlocked' | 'locked' | 'live' | 'cash' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|disabled|iconLeft|iconRight|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, disabled, iconLeft, iconRight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|cash|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'cash' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|glow|padding|interactive|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, glow, padding, interactive, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='glow'] > Literal[value!=/^(?:none|green|gold)$/]",
        "message": "<Card> glow must be one of 'none' | 'green' | 'gold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfettiBurst'] > JSXAttribute > JSXIdentifier[name!=/^(?:fire|message|duration|colors|key|ref|className|style|children)$/]",
        "message": "<ConfettiBurst> doesn't accept that prop. Declared props: fire, message, duration, colors."
      },
      {
        "selector": "JSXOpeningElement[name.name='MilestoneCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:emoji|name|amount|amountLabel|subtitle|current|index|style|key|ref|className|style|children)$/]",
        "message": "<MilestoneCard> doesn't accept that prop. Declared props: emoji, name, amount, amountLabel, subtitle, current, index, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoadMilestone'] > JSXAttribute > JSXIdentifier[name!=/^(?:emoji|name|amount|key|ref|className|style|children)$/]",
        "message": "<RoadMilestone> doesn't accept that prop. Declared props: emoji, name, amount."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|height|tone|showLabel|label|style|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, max, height, tone, showLabel, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:green|gold)$/]",
        "message": "<ProgressBar> tone must be one of 'green' | 'gold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|delta|size|tone|align|style|key|ref|className|style|children)$/]",
        "message": "<StatBlock> doesn't accept that prop. Declared props: label, value, delta, size, tone, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:hero|lg|md)$/]",
        "message": "<StatBlock> size must be one of 'hero' | 'lg' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:green|gold|plain)$/]",
        "message": "<StatBlock> tone must be one of 'green' | 'gold' | 'plain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<StatBlock> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Ticker'] > JSXAttribute > JSXIdentifier[name!=/^(?:amount|source|ago|live|style|key|ref|className|style|children)$/]",
        "message": "<Ticker> doesn't accept that prop. Declared props: amount, source, ago, live, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
